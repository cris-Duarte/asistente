# Production overlay. Supply a private signing key when producing a release:
# idf.py -D SDKCONFIG_DEFAULTS="sdkconfig.defaults;sdkconfig.production" build
CONFIG_SECURE_SIGNED_APPS_NO_SECURE_BOOT=y
CONFIG_SECURE_BOOT_BUILD_SIGNED_BINARIES=y
CONFIG_SECURE_BOOT_SIGNING_KEY="keys/secure_boot_signing_key.pem"
CONFIG_SECURE_BOOT=n
CONFIG_FLASH_ENCRYPTION_ENABLED=n
CONFIG_BOOTLOADER_APP_ROLLBACK_ENABLE=y
