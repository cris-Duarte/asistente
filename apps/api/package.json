{
  "name": "@productivity-assistant/api",
  "version": "0.0.0",
  "private": true,
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "dev:local": "tsx watch src/server.ts",
    "build": "tsup",
    "start": "node dist/server.mjs",
    "owner:init": "tsx src/cli/owner-init.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src --ext .ts",
    "test": "DATABASE_URL=postgresql://test:test@127.0.0.1:5432/test vitest run --passWithNoTests"
  },
  "dependencies": {
    "@hono/node-server": "2.1.1",
    "@productivity-assistant/db-schema": "workspace:*",
    "@productivity-assistant/shared": "workspace:*",
    "@simplewebauthn/server": "^10.0.1",
    "drizzle-orm": "^0.32.0",
    "hono": "^4.13.8",
    "postgres": "^3.4.0",
    "redis": "^5.8.2",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "tsx": "^4.23.13",
    "tsup": "^8.5.0",
    "typescript": "^5.5.0",
    "vitest": "^2.0.0"
  }
}
