# Productivity Assistant - Local Development Environment Variables
# Copy this file to .env and fill in your values

# Database (Local Docker Compose)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/productivity?sslmode=disable
DATABASE_URL_UNPOOLED=postgresql://postgres:postgres@localhost:5432/productivity?sslmode=disable

# ElectricSQL Sync Service (Local)
ELECTRIC_URL=http://localhost:3000
ELECTRIC_SECRET=dev-secret-change-in-production

# Cloudflare Workers (Local via wrangler dev)
JWT_SECRET=dev-jwt-secret-at-least-32-chars-long
API_URL=http://localhost:8787

# Cloudflare R2 (for backups - optional for local)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=productivity-backups

# Neon (for production - get from Neon console)
NEON_API_KEY=
NEON_PROJECT_ID=

# Passkeys/WebAuthn
WEBAUTHN_RP_NAME=Productivity Assistant
WEBAUTHN_RP_ID=localhost
WEBAUTHN_ORIGIN=http://localhost:5173

# Web App
VITE_API_URL=http://localhost:8787
VITE_ELECTRIC_URL=http://localhost:3000

# Firmware (for OTA updates)
OTA_SERVER_URL=http://localhost:8787